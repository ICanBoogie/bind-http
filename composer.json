{
  "name": "icanboogie/bind-http",
  "type": "library",
  "description": "Binds icanboogie/http to ICanBoogie",
  "homepage": "https://icanboogie.org/",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Olivier Laviale",
      "email": "olivier.laviale@gmail.com",
      "homepage": "https://olvlvl.com/",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/ICanBoogie/bind-http/issues",
    "source": "https://github.com/ICanBoogie/bind-http"
  },
  "config": {
    "platform": {
      "php": "8.4.1"
    },
    "sort-packages": true,
    "allow-plugins": {
      "icanboogie/autoconfig": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "icanboogie/icanboogie": "^7.0",
    "icanboogie/http": "^7.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13.4"
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\ICanBoogie\\Binding\\HTTP\\": "tests/lib"
    }
  },
  "extra": {
    "icanboogie": {
      "config-path": "config"
    }
  }
}
